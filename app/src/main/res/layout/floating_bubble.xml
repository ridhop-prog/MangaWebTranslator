<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llFloatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Quick Control Pills Column (AUTO + Solid BG Toggle) -->
    <LinearLayout
        android:id="@+id/llControlPills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Auto Mode Toggle Button Pill -->
        <FrameLayout
            android:id="@+id/btnToggleAuto"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_auto_toggle_off"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewAutoDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_auto_dot_off" />

                <TextView
                    android:id="@+id/tvAutoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- High-Opacity Background Toggle Pill -->
        <FrameLayout
            android:id="@+id/btnToggleBg"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_style_toggle_on"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewBgDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_auto_dot_on" />

                <TextView
                    android:id="@+id/tvBgText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BG SOLID"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Main Draggable Floating Action Button Container -->
    <FrameLayout
        android:id="@+id/flMainFabContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/btnFloatingMain"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_floating_bubble"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_translate"
                android:src="@drawable/ic_translate" />

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Source Language Badge Indicator (JA, KO, EN, ZH) -->
        <TextView
            android:id="@+id/tvLangBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_lang_badge"
            android:elevation="12dp"
            android:text="JA"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Close Floating Service Button -->
        <ImageView
            android:id="@+id/btnCloseFloating"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_lang_badge"
            android:backgroundTint="#FF5252"
            android:contentDescription="@string/cd_clear"
            android:elevation="12dp"
            android:padding="3dp"
            android:src="@drawable/ic_clear" />
    </FrameLayout>

</LinearLayout>
